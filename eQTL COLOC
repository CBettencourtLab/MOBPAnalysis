```{r}

coloc_summary_row <- function(res, comparison_name) {
  as_tibble_row(as.list(res$summary)) %>%
    mutate(comparison = comparison_name, .before = 1)
}

eqtl_oli_coloc_summary <- bind_rows(
  coloc_summary_row(res_eqtl_oli_psp,  "PSP vs OLG eQTL"),
  coloc_summary_row(res_eqtl_oli_als,  "ALS vs OLG eQTL"),
  coloc_summary_row(res_eqtl_oli_mqtl, "mQTL vs OLG eQTL")
) %>%
  mutate(
    across(
      .cols = -comparison,
      .fns = as.numeric
    )
  )

eqtl_oli_coloc_summary
```
```{r}
eqtl_oli_bar_df <- eqtl_oli_coloc_summary %>%
  dplyr::select(
    comparison,
    H0 = PP.H0.abf,
    H1 = PP.H1.abf,
    H2 = PP.H2.abf,
    H3 = PP.H3.abf,
    H4 = PP.H4.abf
  ) %>%
  pivot_longer(
    cols = H0:H4,
    names_to = "hypothesis",
    values_to = "posterior"
  ) %>%
  mutate(
    comparison = factor(
      comparison,
      levels = c("mQTL vs OLG eQTL", "PSP vs OLG eQTL", "ALS vs OLG eQTL"),
      labels = c("mQTL", "PSP", "ALS")
    ),
    hypothesis = factor(
      hypothesis,
      levels = c("H4", "H3", "H2", "H1", "H0")
    )
  )
```

