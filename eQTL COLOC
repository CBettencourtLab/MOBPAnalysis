```{r}
library(dplyr)
library(stringr)
library(tidyr)
library(coloc)
library(ggplot2)


make_eqtl_dataset <- function(eqtl_df, N = 737) {
  
  dat <- eqtl_df %>%
    filter(target_gene_symbol == "MOBP") %>%
    mutate(
      SNP = str_extract(QC_info, "rs[0-9]+"),
      MAF = ifelse(non_ref_af > 0.5, 1 - non_ref_af, non_ref_af)
    ) %>%
    filter(
      !is.na(SNP),
      !is.na(beta_non_ref),
      !is.na(beta_se_non_ref),
      !is.na(MAF)
    ) %>%
    distinct(SNP, .keep_all = TRUE)
  
  list(
    snp     = dat$SNP,
    beta    = dat$beta_non_ref,
    varbeta = dat$beta_se_non_ref^2,
    MAF     = dat$MAF,
    N       = N,
    type    = "quant"
  )
}

dataset_eqtl_oli <- make_eqtl_dataset(
  eqtl_df = eqtls_oli,
  N = 737
)
```

