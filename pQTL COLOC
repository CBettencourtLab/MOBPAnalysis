    as.numeric(res_pqtl_mqtl$summary["PP.H3.abf"])
  ),
  H4 = c(
    as.numeric(res_pqtl_als$summary["PP.H4.abf"]),
    as.numeric(res_pqtl_psp$summary["PP.H4.abf"]),
    as.numeric(res_pqtl_mqtl$summary["PP.H4.abf"])
  )
) %>%
  tidyr::pivot_longer(
    H0:H4,
    names_to = "hypothesis",
    values_to = "posterior"
  ) %>%
  mutate(
    comparison = factor(
      comparison,
      levels = c("ALS vs pQTL", "PSP vs pQTL", "mQTL vs pQTL")
    ),
    hypothesis = factor(
      hypothesis,
      levels = c("H4", "H3", "H2", "H1", "H0")
    )
  )


h4_labels <- pqtl_coloc_summary %>%
  group_by(comparison) %>%
  arrange(hypothesis, .by_group = TRUE) %>%
  mutate(
    ymin = cumsum(posterior) - posterior,
    ymax = cumsum(posterior),
    y = ymin + posterior / 2
  ) %>%
  ungroup() %>%
  filter(hypothesis == "H4") %>%
  mutate(
    label = paste0("PP.H4 = ", sprintf("%.2f", posterior))
  )


p_pqtl_coloc_bar <- ggplot(
  pqtl_coloc_summary,
  aes(x = comparison, y = posterior, fill = hypothesis)
) +
  geom_col(width = 0.8, colour = "grey25", linewidth = 0.25) +
