```{r}
library(dplyr)
library(stringr)
library(coloc)


pqtl_coloc <- pqtl_MOBP %>%
  transmute(
    SNP = rsid,
    beta_pqtl = beta_non_ref,
    se_pqtl = beta_se_non_ref,
    p_pqtl = pval,
    maf = non_ref_af,
    N_pqtl = 416
  ) %>%
  filter(!is.na(beta_pqtl), !is.na(se_pqtl), !is.na(p_pqtl), !is.na(maf)) %>%
  distinct(SNP, .keep_all = TRUE)


dataset_pqtl <- list(
  snp = pqtl_coloc$SNP,
  beta = pqtl_coloc$beta_pqtl,
  varbeta = pqtl_coloc$se_pqtl^2,
  type = "quant",
  N = 416,
  MAF = pqtl_coloc$maf
)

dataset_psp <- datasets$PSP

res_pqtl_psp <- coloc.abf(
  dataset1 = dataset_psp,
  dataset2 = dataset_pqtl
)

dataset_als <- datasets$ALS

res_pqtl_als <- coloc.abf(
  dataset1 = dataset_als,
  dataset2 = dataset_pqtl
)
res_pqtl_psp$summary

res_pqtl_als$summary

res_pqtl_psp$results %>%
