library(dplyr)
library(tidyr)
library(ggplot2)

res_pqtl_mqtl <- coloc.abf(
  dataset1 = dataset.mqtl,
  dataset2 = dataset_pqtl
)
res_pqtl_psp <- coloc.abf(
  dataset1 = dataset_psp,
  dataset2 = dataset_pqtl
)

dataset_als <- datasets$ALS

res_pqtl_als <- coloc.abf(
  dataset1 = dataset_als,
  dataset2 = dataset_pqtl
)
res_pqtl_psp$summary

res_pqtl_als$summary

res_pqtl_psp$results %>%
  arrange(desc(SNP.PP.H4)) %>%
  head(20)
coloc_cols <- c(
  H0 = "#3B6EA5",  # muted blue
  H1 = "#A9D18E",  # soft green
  H2 = "#FFF7AE",  # pale yellow
  H3 = "#F4A259",  # muted orange
  H4 = "#B22222"   # deep red
)



pqtl_coloc_summary <- tibble(
  comparison = c("ALS", "PSP"),
  H0 = c(as.numeric(res_pqtl_als$summary["PP.H0.abf"]),
         as.numeric(res_pqtl_psp$summary["PP.H0.abf"])),
  H1 = c(as.numeric(res_pqtl_als$summary["PP.H1.abf"]),
         as.numeric(res_pqtl_psp$summary["PP.H1.abf"])),
  H2 = c(as.numeric(res_pqtl_als$summary["PP.H2.abf"]),
         as.numeric(res_pqtl_psp$summary["PP.H2.abf"])),
  H3 = c(as.numeric(res_pqtl_als$summary["PP.H3.abf"]),
         as.numeric(res_pqtl_psp$summary["PP.H3.abf"])),
  H4 = c(as.numeric(res_pqtl_als$summary["PP.H4.abf"]),
         as.numeric(res_pqtl_psp$summary["PP.H4.abf"]))
) %>%
  tidyr::pivot_longer(H0:H4, names_to = "hypothesis", values_to = "posterior") %>%
  mutate(
    hypothesis = factor(hypothesis, levels = c("H4", "H3", "H2", "H1", "H0")),
    comparison = factor(comparison, levels = c("ALS", "PSP"))
  )
h4_labels <- pqtl_coloc_summary %>%
  filter(hypothesis == "H4") %>%
  mutate(
    label = paste0("PP.H4 = ", sprintf("%.2f", posterior))
  )
coloc_cols <- c(
  H0 = "#3B6EA5",
  H1 = "#A9D18E",
  H2 = "#FFF7AE",
  H3 = "#F4A259",
  H4 = "#B22222"
)

p_pqtl_coloc_bar <- ggplot(
  pqtl_coloc_summary,
  aes(x = comparison, y = posterior, fill = hypothesis)
) +
  geom_col(width = 0.8, colour = "grey25", linewidth = 0.25) +
  scale_fill_manual(
    values = coloc_cols,
    labels = c(
      H4 = "H4: both, shared",
      H3 = "H3: both, distinct",
      H2 = "H2: pQTL only",
      H1 = "H1: disease only",
      H0 = "H0: neither"
    )
  ) + geom_text(
  data = h4_labels,
  aes(
    x = comparison,
    y = posterior / 2,
    label = label
  ),
  colour = "white",
  fontface = "bold",
  size = 4
) +
  scale_y_continuous(limits = c(0, 1), breaks = seq(0, 1, 0.25), expand = c(0, 0)) +
  labs(
    title = "Disease vs MOBP pQTL",
    x = NULL,
    y = "Posterior probability",
    fill = NULL
  ) +
  theme_classic(base_size = 14)

