```{r}


usage_for_models <- usage_mat  
stopifnot(all(colnames(usage_for_models) == rownames(pheno)))

results_list_Tcarrier <- lapply(seq_len(nrow(usage_for_models)), function(i) {
  
  y <- as.numeric(usage_for_models[i, ])
  
  df <- data.frame(
    expr = y,
    X3 = pheno$X3.39523003_C,
    T_carrier = pheno$T_carrier,
    T_carrier_label = pheno$T_carrier_label,
    cg = pheno$cg15069948_adj,
    NeuNNeg_SOX10Pos = pheno$NeuNNeg_SOX10Pos,
    RIN = pheno$RIN,
    Age = pheno$Age,
    Gender = factor(pheno$Gender)
  )
  
  df <- df[complete.cases(df), ]
  
  fit <- lm(
    expr ~ T_carrier + Age + RIN + Gender + NeuNNeg_SOX10Pos,
    data = df
  )
  
  fit2 <- lm(
    expr ~ cg + Age + RIN + Gender + NeuNNeg_SOX10Pos,
    data = df
  )
  
  fit3 <- lm(
    expr ~ T_carrier * cg + Age + RIN + Gender + NeuNNeg_SOX10Pos,
    data = df
  )
  
  s <- summary(fit)$coefficients
  s2 <- summary(fit2)$coefficients
  s3 <- summary(fit3)$coefficients
  
  data.frame(
    gene = rownames(usage_for_models)[i],
    
    T_carrier_beta = s["T_carrier", "Estimate"],
    T_carrier_p = s["T_carrier", "Pr(>|t|)"],
    
    cg_beta = s2["cg", "Estimate"],
    cg_p = s2["cg", "Pr(>|t|)"],
    
    interaction_beta = s3["T_carrier:cg", "Estimate"],
    interaction_p = s3["T_carrier:cg", "Pr(>|t|)"],
    
    n = nrow(df),
    n_CC = sum(df$T_carrier == 0),
    n_T_carrier = sum(df$T_carrier == 1)
  )
})

results_Tcarrier <- do.call(rbind, results_list_Tcarrier)
rownames(results_Tcarrier) <- results_Tcarrier$gene

results_Tcarrier <- results_Tcarrier[order(results_Tcarrier$interaction_p), ]

head(results_Tcarrier, 20)
