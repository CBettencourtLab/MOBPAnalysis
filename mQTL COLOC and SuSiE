run_abf_pair <- function(ds1, ds2, name1, name2,
                         p1 = 1e-3, p2 = 1e-3, p12 = 1e-5) {

  res <- coloc.abf(
    dataset1 = ds1,
    dataset2 = ds2,
    p1 = p1,
    p2 = p2,
    p12 = p12
  )

  tibble(
    trait1 = name1,
    trait2 = name2,
    nsnps  = as.numeric(res$summary["nsnps"]),
    H0     = as.numeric(res$summary["PP.H0.abf"]),
    H1     = as.numeric(res$summary["PP.H1.abf"]),
    H2     = as.numeric(res$summary["PP.H2.abf"]),
    H3     = as.numeric(res$summary["PP.H3.abf"]),
    H4     = as.numeric(res$summary["PP.H4.abf"])
  )
}

