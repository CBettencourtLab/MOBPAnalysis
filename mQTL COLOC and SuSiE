```{r runsusie_cc}
library(susieR)

runsusie_cc <- function(ds, L = 10, maxit = 10000, trait_label = NULL) {
  z <- ds$beta / sqrt(ds$varbeta)
  R <- ds$LD

  # Small shrinkage to stabilise LD (keeps diag ~1, shrinks off-diagonals a bit)
  R <- 0.99 * R + 0.01 * diag(nrow(R))

  # First attempt: standard susie_rss
  susie_fit <- try(
    susie_rss(
      z        = z,
      R        = R,
      n        = ds$N,
      L        = L,
      coverage = 0.95,
      max_iter = maxit
    ),
    silent = TRUE
  )

  # If that failed with the "prior variance" error, retry with fixed prior variance
  if (inherits(susie_fit, "try-error")) {
    msg <- conditionMessage(attr(susie_fit, "condition"))
    if (!is.null(trait_label)) {
      message(trait_label, ": susie_rss failed, retrying with fixed prior_variance. Original error: ", msg)
    } else {
      message("susie_rss failed, retrying with fixed prior_variance. Original error: ", msg)
    }

    susie_fit <- susie_rss(
      z        = z,
      R        = R,
      n        = ds$N,
      L        = L,
      coverage = 0.95,
      max_iter = maxit,
      estimate_prior_variance = FALSE,
      prior_variance          = 0.05   # you can tweak this (e.g. 0.01–0.1)
    )
  }

  # Attach SNP IDs and positions for plotting
  susie_fit$snp <- ds$snp
  if (!is.null(ds$pos)) susie_fit$pos <- ds$pos
  susie_fit$label <- ds$label

  susie_fit
}


